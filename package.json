{
  "name": "trilharm",
  "version": "0.1.0",
  "private": true,
  "description": "Trilha RM - app pessoal para memorizar termos de engenharia de software (flashcards, quiz, digitar, associar, V/F, explique, glossario, revisao espacada).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js --port 8790",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
